# EAS packs from the git root. Keep Inspect uploads small (<20 MB).
# This file replaces .gitignore for the upload archive.

# Sibling packages (not needed for Continental Inspect APK)
/tanda-web
/docs

# Dependencies & build caches
node_modules
**/node_modules
.next
**/.next
.expo
**/.expo
dist
web-build
.turbo
.vercel
coverage

# Env / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Native folders (generated by prebuild; EAS generates on server)
/continentalinspect/ios
/continentalinspect/android

# Tooling / IDE / OS
.claude
**/.claude
.vscode
**/.vscode
.DS_Store
*.log
*.tsbuildinfo
.metro-health-check*

# Keys
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
